# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# TÜİK Data Portal API key (Keycloak client credentials)
# Obtained via https://giris.tuik.gov.tr (SMS-verified)
TUIK_API_KEY=

# If TÜİK issues a client_id/client_secret pair instead of a single key,
# use these instead and adjust the token-fetch code accordingly:
# TUIK_CLIENT_ID=
# TUIK_CLIENT_SECRET=

# Bluesky account for instant Türkiye change notices. Use a dedicated
# account, separate from any account used for other posting.
#
# App Password from: Bluesky app -> Settings -> App Passwords -> Add App
# Password. Never the account login password itself.
#
# BLUESKY_DATA_HANDLE must be the BARE handle, no leading "@" -- that's just
# how the app displays it to humans, the API login call rejects it with the
# "@" included.
BLUESKY_DATA_HANDLE=
BLUESKY_DATA_APP_PASSWORD=
